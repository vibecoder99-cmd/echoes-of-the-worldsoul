+-- E2j5h Stage 4: durable two-phase pending record for the Dissolve/
+-- DissolveDirect mutation. Closes the two crash windows identified by the
+-- E2j5h Stage 3 design report (Window A: item removed+saved, crash before
+-- ap_dissolved_items is written -> silent unaudited loss; Window B: record
+-- committed, crash before rewards finish -> permanent reward lockout via
+-- the ap_dissolved_items already-dissolved guard).
+--
+-- This does NOT provide true atomicity (no cross-statement DB transaction
+-- exists at the Lua binding layer -- see the Stage 3 design report Section
+-- 1/3-A). It provides idempotent recoverability: a durable row exists for
+-- the whole window between item-removal and reward completion, and the
+-- login-time recovery pass in ap_forge.lua (AP.Forge.ReconcilePendingDissolutions)
+-- resolves any row left non-COMPLETE by a crash, exactly once, on next login.
+-- Modeled directly on this schema's own ap_session_state.clean_exit pattern
+-- (Residue reconciliation) and on AzerothCore's own mail-orphan-recovery idiom.
+--
+-- status values: PENDING_REMOVAL -> REMOVED -> RECORDED -> COMPLETE
+--   PENDING_REMOVAL: row reserved, item not yet touched.
+--   REMOVED:         item physically removed and SaveToDB committed, but the
+--                     ap_dissolved_items ledger row has not been written yet.
+--   RECORDED:        ap_dissolved_items row committed; rewards not yet granted.
+--   COMPLETE:         rewards granted (or a startup/login recovery pass
+--                     verified nothing was missed). Terminal state.
+--
+-- Reward columns are snapshotted at confirmation time so a later change to
+-- AP.Forge.Rewards cannot alter an in-flight payout.
+-- Primary key is (guid, item_entry) -- the same granularity as
+-- ap_dissolved_items, which permanently blocks any second dissolution of the
+-- same item_entry for an account, so at most one non-COMPLETE row can ever
+-- meaningfully exist per (guid, item_entry). A second dissolution attempt
+-- while a row is still non-COMPLETE is rejected as "already pending" by
+-- ap_forge.lua rather than overwriting in-flight state -- this is the
+-- idempotency guard against rapid duplicate requests.
+CREATE TABLE IF NOT EXISTS `ap_dissolution_pending` (
+    `guid`               INT UNSIGNED     NOT NULL,
+    `account_id`         INT UNSIGNED     NOT NULL,
+    `item_entry`         INT UNSIGNED     NOT NULL,
+    `item_instance_guid` INT UNSIGNED     NOT NULL DEFAULT 0,
+    `quality`            TINYINT UNSIGNED NOT NULL DEFAULT 1,
+    `essence_reward`     INT UNSIGNED     NOT NULL DEFAULT 0,
+    `gold_reward`        INT UNSIGNED     NOT NULL DEFAULT 0,
+    `residue_reward`     INT UNSIGNED     NOT NULL DEFAULT 0,
+    `status`             VARCHAR(16)      NOT NULL DEFAULT 'PENDING_REMOVAL',
+    `created_at`         TIMESTAMP        NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    `updated_at`         TIMESTAMP        NOT NULL DEFAULT CURRENT_TIMESTAMP
+                                          ON UPDATE CURRENT_TIMESTAMP,
+    PRIMARY KEY (`guid`, `item_entry`),
+    KEY `idx_guid_status` (`guid`, `status`)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;
+
